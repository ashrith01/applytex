{
  "manifest_version": 3,
  "name": "ApplyTeX ATS",
  "version": "0.2.0",
  "description": "Capture jobs, review-fill applications, and track receipts with a local or self-hosted ApplyTeX ATS API.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://www.linkedin.com/*",
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkdaysite.com/*",
    "https://*.icims.com/*",
    "https://*.smartrecruiters.com/*",
    "https://apply.workable.com/*",
    "https://*.workable.com/*",
    "https://www.indeed.com/*",
    "https://www.ziprecruiter.com/*",
    "https://www.glassdoor.com/*",
    "https://wellfound.com/*",
    "https://www.dice.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open ApplyTeX ATS"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
